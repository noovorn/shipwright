+import { describe, expect, it } from "vitest";
+import { importCsv } from "@/lib/csv";
+
+describe("importCsv", () => {
+  it("keeps quoted amounts with thousands separators intact", () => {
+    const [row] = importCsv('customer,amount,dueDate\nAcme,"1,200.00",2026-12-01', "alice");
+    expect(row.amount).toBe("1200.00");
+  });
+
+  it("rejects non-numeric amounts", () => {
+    expect(() => importCsv("customer,amount,dueDate\nAcme,abc,2026-12-01", "alice")).toThrow(/invalid amount/);
+  });
+});
