@@ -0,0 +1,18 @@
+import { describe, expect, it } from "vitest";
+import { parseAmount } from "@/lib/money";
+
+describe("parseAmount", () => {
+  it("parses plain and dollar-prefixed amounts", () => {
+    expect(parseAmount("450.00")).toBe(450);
+    expect(parseAmount("$980.50")).toBe(980.5);
+  });
+
+  it("parses thousands separators", () => {
+    expect(parseAmount("2,300.00")).toBe(2300);
+    expect(parseAmount("1,250,000.00")).toBe(1_250_000);
+  });
+
+  it("rejects non-numeric input instead of returning a partial number", () => {
+    expect(() => parseAmount("12abc")).toThrow(/Invalid amount/);
+  });
+});
