@@ -1,10 +1,25 @@
 "use server";
 
-import { redirect } from "next/navigation";
-import { removeInvoice } from "@/lib/store";
+import { revalidatePath } from "next/cache";
+import { notFound, redirect } from "next/navigation";
+import { getCurrentUserId } from "@/lib/session";
+import { getInvoice, removeInvoice, updateInvoice } from "@/lib/store";
 
 export async function deleteInvoice(formData: FormData) {
   const id = formData.get("id") as string;
   removeInvoice(id);
   redirect("/");
 }
+
+export async function markInvoicePaid(formData: FormData) {
+  const id = formData.get("id");
+  if (typeof id !== "string") notFound();
+  // Server actions are callable directly, so re-check ownership rather than trusting the form.
+  const userId = await getCurrentUserId();
+  const invoice = getInvoice(id);
+  if (!invoice || invoice.ownerId !== userId) notFound();
+
+  updateInvoice(id, { status: "paid" });
+  revalidatePath("/");
+  revalidatePath(`/invoices/${id}`);
+}
