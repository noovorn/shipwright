diff --git a/app/invoices/actions.test.ts b/app/invoices/actions.test.ts
new file mode 100644
index 0000000..99065e4
--- /dev/null
+++ b/app/invoices/actions.test.ts
@@ -0,0 +1,48 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { getInvoice, resetStore } from "@/lib/store";
+
+let currentUser: string | null = "alice";
+vi.mock("@/lib/session", () => ({ getCurrentUserId: async () => currentUser }));
+vi.mock("next/cache", () => ({ revalidatePath: vi.fn() }));
+vi.mock("next/navigation", () => ({
+  notFound: () => {
+    throw new Error("NEXT_NOT_FOUND");
+  },
+  redirect: vi.fn(),
+}));
+
+const { markInvoicePaid } = await import("@/app/invoices/actions");
+
+const form = (id: string) => {
+  const fd = new FormData();
+  fd.set("id", id);
+  return fd;
+};
+
+describe("markInvoicePaid", () => {
+  beforeEach(() => {
+    resetStore();
+    currentUser = "alice";
+  });
+
+  it("marks the owner's open invoice as paid", async () => {
+    await markInvoicePaid(form("inv_1001"));
+    expect(getInvoice("inv_1001")?.status).toBe("paid");
+  });
+
+  it("refuses another user's invoice", async () => {
+    currentUser = "bob";
+    await expect(markInvoicePaid(form("inv_1001"))).rejects.toThrow("NEXT_NOT_FOUND");
+    expect(getInvoice("inv_1001")?.status).toBe("open");
+  });
+
+  it("refuses when signed out", async () => {
+    currentUser = null;
+    await expect(markInvoicePaid(form("inv_1001"))).rejects.toThrow("NEXT_NOT_FOUND");
+    expect(getInvoice("inv_1001")?.status).toBe("open");
+  });
+
+  it("refuses an unknown id", async () => {
+    await expect(markInvoicePaid(form("inv_nope"))).rejects.toThrow("NEXT_NOT_FOUND");
+  });
+});
diff --git a/app/invoices/actions.ts b/app/invoices/actions.ts
index f6a9bca..aae3af7 100644
--- a/app/invoices/actions.ts
+++ b/app/invoices/actions.ts
@@ -1,10 +1,24 @@
 "use server";
 
-import { redirect } from "next/navigation";
-import { removeInvoice } from "@/lib/store";
+import { revalidatePath } from "next/cache";
+import { notFound, redirect } from "next/navigation";
+import { getCurrentUserId } from "@/lib/session";
+import { getInvoice, removeInvoice, updateInvoice } from "@/lib/store";
 
 export async function deleteInvoice(formData: FormData) {
   const id = formData.get("id") as string;
   removeInvoice(id);
   redirect("/");
 }
+
+export async function markInvoicePaid(formData: FormData) {
+  const id = formData.get("id");
+  const userId = await getCurrentUserId();
+  // The id comes from a hidden field, so re-check ownership here rather than trusting the form.
+  const invoice = typeof id === "string" ? getInvoice(id) : undefined;
+  if (!userId || !invoice || invoice.ownerId !== userId) notFound();
+
+  updateInvoice(invoice.id, { status: "paid" });
+  revalidatePath("/");
+  revalidatePath(`/invoices/${invoice.id}`);
+}
