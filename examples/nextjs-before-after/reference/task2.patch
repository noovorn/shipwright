diff --git a/app/invoices/actions.test.ts b/app/invoices/actions.test.ts
new file mode 100644
index 0000000..c9e99d0
--- /dev/null
+++ b/app/invoices/actions.test.ts
@@ -0,0 +1,57 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const session = vi.hoisted(() => ({ uid: undefined as string | undefined }));
+
+vi.mock("next/headers", () => ({
+  cookies: async () => ({ get: (name: string) => (name === "uid" && session.uid ? { value: session.uid } : undefined) }),
+}));
+vi.mock("next/cache", () => ({ revalidatePath: vi.fn() }));
+vi.mock("next/navigation", () => ({
+  redirect: () => {
+    throw new Error("NEXT_REDIRECT");
+  },
+  notFound: () => {
+    throw new Error("NEXT_NOT_FOUND");
+  },
+}));
+
+const { deleteInvoice, markInvoicePaid } = await import("@/app/invoices/actions");
+const { getInvoice, resetStore } = await import("@/lib/store");
+
+const form = (id: string) => {
+  const fd = new FormData();
+  fd.set("id", id);
+  return fd;
+};
+
+beforeEach(() => {
+  resetStore();
+  session.uid = undefined;
+});
+
+describe("markInvoicePaid", () => {
+  it("marks the owner's invoice as paid", async () => {
+    session.uid = "alice";
+    await markInvoicePaid(form("inv_1001"));
+    expect(getInvoice("inv_1001")?.status).toBe("paid");
+  });
+
+  it("rejects signed-out requests", async () => {
+    await expect(markInvoicePaid(form("inv_1001"))).rejects.toThrow("NEXT_REDIRECT");
+    expect(getInvoice("inv_1001")?.status).toBe("open");
+  });
+
+  it("rejects another user's invoice", async () => {
+    session.uid = "bob";
+    await expect(markInvoicePaid(form("inv_1001"))).rejects.toThrow("NEXT_NOT_FOUND");
+    expect(getInvoice("inv_1001")?.status).toBe("open");
+  });
+});
+
+describe("deleteInvoice", () => {
+  it("rejects another user's invoice", async () => {
+    session.uid = "bob";
+    await expect(deleteInvoice(form("inv_1001"))).rejects.toThrow("NEXT_NOT_FOUND");
+    expect(getInvoice("inv_1001")).toBeDefined();
+  });
+});
diff --git a/app/invoices/actions.ts b/app/invoices/actions.ts
index f6a9bca..baa5923 100644
--- a/app/invoices/actions.ts
+++ b/app/invoices/actions.ts
@@ -1,10 +1,30 @@
 "use server";
 
-import { redirect } from "next/navigation";
-import { removeInvoice } from "@/lib/store";
+import { revalidatePath } from "next/cache";
+import { notFound, redirect } from "next/navigation";
+import { getCurrentUserId } from "@/lib/session";
+import { getInvoice, removeInvoice, updateInvoice, type Invoice } from "@/lib/store";
+
+/** Server actions are public endpoints: authenticate and check ownership on every call. */
+async function requireOwnedInvoice(formData: FormData): Promise<Invoice> {
+  const userId = await getCurrentUserId();
+  if (!userId) redirect("/");
+  const id = formData.get("id");
+  const invoice = typeof id === "string" ? getInvoice(id) : undefined;
+  if (!invoice || invoice.ownerId !== userId) notFound();
+  return invoice;
+}
 
 export async function deleteInvoice(formData: FormData) {
-  const id = formData.get("id") as string;
-  removeInvoice(id);
+  const invoice = await requireOwnedInvoice(formData);
+  removeInvoice(invoice.id);
+  revalidatePath("/");
   redirect("/");
 }
+
+export async function markInvoicePaid(formData: FormData) {
+  const invoice = await requireOwnedInvoice(formData);
+  updateInvoice(invoice.id, { status: "paid" });
+  revalidatePath("/");
+  revalidatePath(`/invoices/${invoice.id}`);
+}
